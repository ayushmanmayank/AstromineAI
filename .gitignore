# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
ENV/
pip-wheel-metadata/

# Jupyter
.ipynb_checkpoints/

# Environment files
.env
.env.*
!.env.example

# Build and test output
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
node_modules/
logs/

# Data and model artifacts
datasets/*
!datasets/.gitkeep
trained_models/*
!trained_models/.gitkeep
uploads/*
!uploads/.gitkeep

# Global-mosaic dataset: the raw/processed rasters and tiles are large
# and regenerable (via scripts/mosaic_acquire.py + its real, documented
# URLs) -- gitignored like the rest of datasets/. Its manifests (real
# URLs + sha256 + size, no raster bytes) are the one thing meant to be
# committed, per that task's explicit instruction.
!datasets/mosaic
datasets/mosaic/*
!datasets/mosaic/manifests

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
